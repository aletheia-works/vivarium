{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::vivarium-*/*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:${account_id}:log-group:/vivarium/*",
        "arn:aws:logs:*:${account_id}:log-group:/vivarium/*:*"
      ]
    },
    {
      "Sid": "RunOwnMicrovms",
      "Effect": "Allow",
      "Action": [
        "lambda:RunMicrovm",
        "lambda:GetMicrovm",
        "lambda:SuspendMicrovm",
        "lambda:ResumeMicrovm",
        "lambda:TerminateMicrovm",
        "lambda:CreateMicrovmAuthToken",
        "lambda:GetMicrovmImage"
      ],
      "Resource": "arn:aws:lambda:*:${account_id}:microvm-image:vivarium-*"
    },
    {
      "Sid": "PassLambdaNetworkConnectors",
      "Effect": "Allow",
      "Action": "lambda:PassNetworkConnector",
      "Resource": "*"
    },
    {
      "Sid": "ListMicrovms",
      "Effect": "Allow",
      "Action": "lambda:ListMicrovms",
      "Resource": "*"
    }
  ]
}
